ship = Laythe 1
version = 1.12.5
description = Uncrewed Laythe probe (one way, transmits; first Laythe landing or splashdown; air 0.6 atm, g 7.85). Entry vehicle = Eve 2's lander (flown: entry 4,384 m/s at Eve, splashdown 4.7 m/s) with an RA-100 and an RTG: OKTO (root), Advanced Inline Stabilizer, nose cone, 2 x Z-1k + 2 x Z-400 (2,810 EC), Science Jr in the recess of the 10 m inflatable heat shield, 3 goo, thermometer, barometer, atmospheric spectro-variometer, seismic, gravioli, RA-100 (fixed dish: link through the entry, 158 Gm to DSN 3), RTG + 2 x OX-STAT-XL, 4 x Mk2-R in their own stage. Capture stage under the shield: Terrier + FL-T800 (capture at Laythe ~1,270, circularize, deorbit; dropped before `inflate`). Transfer stage Poodle + X200-32. Launcher = Eve 2's (flown #49 with this nose shape): Twin-Boar + S3-3600 + ADTP-2-3, Skipper + X200-32 + X200-16, AV-R8 x4 + Tail Fin x4 / AV-R8 x4 / AV-T1 x4; whole stack rigid + autostrut Root. Stages: 1 Twin-Boar, 2 TD-25 + Skipper, 3 TD-25 + Poodle, 4 TD-12 + Terrier, 5 TD-12 (drops the capture stage), 6 Mk2-R x4, 7 the shield's own decoupler (never staged). Plan: docs/jool-fleet-plan.md.
type = VAB
size = 3,10,3
steamPublishedFileId = 0
persistentId = 585895004
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
