ship = Eeloo 1
version = 1.12.5
description = Uncrewed Eeloo orbiter + lander (one way, transmits; first Eeloo visit). Lander = Dres 1's, unchanged: OKTO (root), 2 x Z-1k, small reaction wheel, FL-T800 + FL-T400 (6 t LF/Ox) + Terrier (~3,680 m/s vac at 9.05 t), 4 x LT-1 legs, science (Science Jr, 3 goo, thermometer, barometer, gravioli, seismic, magnetometer boom), RA-100 (fixed, 100 G: 158 Gm to DSN 3) + 1 HG-55 backup, RTG 0.75 EC/s + 2 x OX-STAT-XL (0.11 EC/s each at Eeloo: 0.038 x sun), 2,810 EC. Transfer stage + launcher = Moho 1's (Eeloo is near its perihelion at arrival: ~5,500 m/s needed after LKO, Dres 1's stack gives 5,440): Poodle + X200-32 + X200-16 (~3,410 m/s vac: LKO top-up ~550, ejection ~2,000, mid-course, the start of the capture at 250 kN; the Terrier finishes it), Skipper + X200-32 + X200-16, Twin-Boar + X200-32 + X200-16. Fins on all three atmospheric stages (AV-R8 x4, AV-R8 x4, AV-T1 x4); whole stack rigid + autostrut Root. Stages: 1 Twin-Boar, 2 TD-25 + Skipper, 3 TD-25 + Poodle, 4 TD-12 + Terrier. Pad ~138.7 t of 140.
type = VAB
size = 3,10,3
steamPublishedFileId = 0
persistentId = 1194964509
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
