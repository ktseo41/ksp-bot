ship = Duna 2
version = 1.12.5
description = Uncrewed Duna surface probe (one way, transmits: contract 'Science data from surface of Duna'). Lander: OKTO (root), 2 x Z-1k, small reaction wheel, Science Jr inline, FL-T400 + Terrier (~1,980 m/s vac: capture ~460 + circularize ~200 + deorbit ~50 + powered landing ~700), 4 x LT-1 legs, 3 x Mk2-R (own stage), 2 x RA-15 fixed dishes (link through the entry, 61 Gm to DSN 3), RTG + 2 x OX-STAT-XL, 2,810 EC, science goo/thermo/baro/gravioli/seismic/Jr. Transfer stage: Poodle + X200-16 (~2,480 m/s: LKO top-up, ejection ~1,080, trims, then its rest opens the capture). Launcher = Duna 1's: Mainsail + 2 x X200-32, Skipper + X200-32; fins on all three atmospheric stages (AV-R8 x4, AV-R8 x4, AV-T1 x4); whole stack rigid + autostrut Root. Stages: 1 Mainsail, 2 TD-25 + Skipper, 3 TD-25 + Poodle, 4 TD-12 + Terrier, 5 chutes.
type = VAB
size = 3,10,3
steamPublishedFileId = 0
persistentId = 1088936619
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
