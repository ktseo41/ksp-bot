ship = Moho 1
version = 1.12.5
description = Uncrewed Moho orbiter + lander (one way, transmits). Lander: OKTO, Z-1k, small reaction wheel, FL-T800 + FL-T400, Terrier (~4,200 m/s vac), 4 x LT-1 legs, science (Science Jr, 3 goo, thermometer, barometer, gravioli, seismic, magnetometer boom), 2 x HG-55 (combined 25 G -> 79 Gm with DSN 3; Kerbin-Moho max 19 Gm), 4 x OX-STAT-XL (~10x sun at Moho), 1,810 EC. Ejection stage: Poodle + X200-32 + X200-16 (~3,500 m/s: LKO top-up, ejection ~2,050, mid-course ~300, the rest starts the capture burn at 250 kN; the Terrier finishes it). Launcher: Twin-Boar + X200-32 + X200-16, Skipper + X200-32 + X200-16 (~2,770 SL1+vac2). Fins on all three atmospheric stages; whole stack rigid + autostrut Root.
type = VAB
size = 3,10,3
steamPublishedFileId = 0
persistentId = 591498258
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
