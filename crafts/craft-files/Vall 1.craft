ship = Vall 1
version = 1.12.5
description = Uncrewed Vall orbiter + lander (one way, transmits; first Vall landing). Dres 1's stack, unchanged (flown #51: pad check 1175 SL / 1043 SL / 2742 vac / 3683 vac, Poodle 1,759 in LKO): OKTO (root), 2 x Z-1k, small reaction wheel, FL-T800 + FL-T400 (6 t LF/Ox) + Terrier (3,683 m/s vac at 9.05 t; 2.3 g of Vall at the landing), 4 x LT-1 legs, science (Science Jr, 3 goo, thermometer, barometer, gravioli, seismic, magnetometer boom), RA-100 (fixed, 100 G: 158 Gm to DSN 3; Kerbin-Jool 55-83 Gm) + 1 HG-55 backup, RTG 0.75 EC/s + 2 x OX-STAT-XL, 2,810 EC. Transfer stage Poodle + X200-32; launcher Mainsail + 2 x X200-32, Skipper + X200-32; fins on all three atmospheric stages; whole stack rigid + autostrut Root. Stages: 1 Mainsail, 2 TD-25 + Skipper, 3 TD-25 + Poodle, 4 TD-12 + Terrier. Plan: docs/jool-fleet-plan.md.
type = VAB
size = 3,10,3
steamPublishedFileId = 0
persistentId = 922359166
rot = 0,0,0,1
missionFlag = Squad/Flags/default
vesselType = Ship
