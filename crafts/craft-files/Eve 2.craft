ship = Eve 2
version = 1.12.5
description = Uncrewed Eve satellite (contract: equatorial 17,206 x 19,131 km orbit, Science Jr aboard) + Eve surface probe. Carrier = Poodle + X200-32 stage kept as the satellite: OKTO (root), stabilizer, Z-1k, science (Jr, 2 goo, thermo, baro, gravioli), RA-15 relay + 2 HG-55, 4 OX-4L panels, 4 Z-400. On top (released last): the lander = Terrier + FL-T200 deorbit stage under a 10 m inflatable heat shield (heat face down, toward the carrier), lander body in the shield's mid recess (Science Jr, 2 Z-1k, OKTO, stabilizer, nose), radial 3 goo + thermo/baro/seismic/gravioli, 4 Z-400, 4 OX-STAT-XL, 2 Mk2-R, RA-15 (fixed dish: link through the entry, 61 Gm to DSN 3). Launcher: Twin-Boar + S3-3600 + ADTP-2-3 (Ike Station 1's, 3.75 m keeps the stack under the 36 m pad limit); Skipper + X200-32 + X200-16 (Ike Station 1 / Jool 1 pattern), fins on every atmospheric stage, whole stack rigid + autostrut Root. Stages: 1 Twin-Boar, 2 Skipper, 3 Poodle, 4 lander release, 5 Terrier, 6 deorbit stage drop, 7 chutes; the shield is inflated by its part event (not stageable).
type = VAB
size = 3,10,3
steamPublishedFileId = 0
